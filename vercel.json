{
  "functions": {
    "api/index.ts": {
      "includeFiles": "{src,profile,prompts,examples,workflows,eval}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
