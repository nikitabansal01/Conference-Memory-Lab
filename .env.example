# Local dev uses files under data/ and profile/ when DATABASE_URL is unset.
# Production on Vercel: connect Neon Postgres + Blob in the Vercel dashboard.

# Neon Postgres (Vercel Storage → Postgres, or neon.com)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Vercel Blob (Vercel Storage → Blob — auto-injected as BLOB_READ_WRITE_TOKEN)
BLOB_READ_WRITE_TOKEN=

# Clerk auth (clerk.com → create application)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional beta invite-only allowlist (comma-separated emails)
# AUTH_ALLOWED_EMAILS=you@example.com,friend@example.com

# Local CLI/dev user id when Clerk is not configured (defaults to local-dev)
# AUTH_DEV_USER_ID=local-dev

# Set AUTH_REQUIRED=true to force Clerk sign-in on localhost (default: open app without sign-up)
# AUTH_REQUIRED=true

# LLM — required for in-app Remember / Think / Create / Review
OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
